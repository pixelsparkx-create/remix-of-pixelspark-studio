# ---------------------------------------------------------------------------
# PixelSpark Studio — environment variables
# Copy to .env and fill in the values from your own Supabase project.
# ---------------------------------------------------------------------------

# --- Browser-safe (bundled into the client) --------------------------------
# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Google sign-in flow.
#   lovable  → use the Lovable OAuth broker (only works inside Lovable)
#   supabase → use standard Supabase OAuth (use this on your own hosting)
VITE_AUTH_MODE="supabase"

# --- Server-only (never exposed to the browser) ----------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
# Supabase → Project Settings → API → service_role. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- AI (Goldie assistant) -------------------------------------------------
# Standalone: create a free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""
# Optional model override (default: gemini-2.5-flash)
GOOGLE_AI_MODEL=""
# Only present when running inside Lovable; leave empty elsewhere.
LOVABLE_API_KEY=""
